<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Controle de Gastos</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.5/babel.min.js"></script>
<style>
  :root {
    --ink: #1F2E27;
    --paper: #F5F1E6;
    --paper-line: #DED5B8;
    --paper-line-2: #E9E2CC;
    --brass: #B8923F;
    --sage: #3F6350;
    --sage-soft: #DDE6DE;
    --brick: #A85440;
    --brick-soft: #EEDCD5;
    --ink-soft: #6B786F;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
  }
  .ledger-font { font-family: 'Fraunces', serif; }
  .mono-font { font-family: 'IBM Plex Mono', monospace; font-variant-numeric: tabular-nums; }
  .wrap { max-width: 880px; margin: 0 auto; padding: 32px 16px; }
  @media (min-width: 768px) { .wrap { padding: 40px 32px; } }

  .header {
    display: flex; flex-direction: column; gap: 20px;
    justify-content: space-between; align-items: flex-start;
    padding-bottom: 24px; margin-bottom: 24px;
    border-bottom: 2px solid var(--ink);
  }
  @media (min-width: 768px) { .header { flex-direction: row; align-items: flex-start; } }
  .eyebrow { font-size: 12px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--brass); margin-bottom: 4px; }
  h1 { font-size: 30px; margin: 0; font-weight: 600; }
  @media (min-width: 768px) { h1 { font-size: 36px; } }
  .subtitle { font-size: 14px; color: var(--ink-soft); margin-top: 4px; }

  .stamp {
    flex-shrink: 0; width: 108px; height: 108px; border-radius: 50%;
    border: 2px dashed var(--brass); transform: rotate(-6deg);
    background: rgba(184,146,63,0.06);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
  }
  .stamp-value { font-size: 22px; font-weight: 600; line-height: 1; }
  .stamp-label { font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); margin-top: 4px; text-align: center; font-family: 'Inter', sans-serif; }

  .toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
  .toggle { display: flex; flex-wrap: wrap; gap: 4px; padding: 4px; border-radius: 999px; background: var(--paper-line-2); }
  .toggle-btn { padding: 6px 12px; border-radius: 999px; font-size: 13px; font-weight: 500; border: none; cursor: pointer; background: transparent; color: var(--ink-soft); }
  .toggle-btn.active { background: var(--ink); color: var(--paper); }

  .btn { border: none; cursor: pointer; border-radius: 999px; font-weight: 500; padding: 8px 18px; font-size: 14px; display: inline-flex; align-items: center; gap: 6px; }
  .btn-primary { background: var(--ink); color: var(--paper); }
  .btn-save { background: var(--brass); color: white; font-weight: 600; border-radius: 8px; margin-top: 16px; padding: 10px 20px; }

  .panel, .card { background: white; border: 1px solid var(--paper-line); border-radius: 16px; padding: 18px; margin-bottom: 20px; }
  .type-toggle { display: flex; gap: 8px; margin-bottom: 14px; }
  .type-btn { flex: 1; padding: 8px 10px; border-radius: 10px; font-size: 14px; font-weight: 500; border: none; cursor: pointer; background: var(--paper); color: var(--ink-soft); }
  .type-btn.active-expense { background: var(--brick-soft); color: var(--brick); }
  .type-btn.active-income { background: var(--sage-soft); color: var(--sage); }

  .form-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
  @media (min-width: 640px) { .form-grid { grid-template-columns: 1fr 1fr; } }
  .field-full { grid-column: 1 / -1; }
  label.field-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-soft); display: block; margin-bottom: 4px; }
  select, input[type="text"], input[type="date"] {
    width: 100%; padding: 9px 12px; border-radius: 8px; font-size: 14px;
    border: 1px solid var(--paper-line); background: var(--paper); color: var(--ink); font-family: inherit;
  }
  select:focus, input:focus, button:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--brass); }

  .stat-grid { display: grid; grid-template-columns: 1fr; gap: 12px; margin-bottom: 20px; }
  @media (min-width: 640px) { .stat-grid { grid-template-columns: repeat(3, 1fr); } }
  .stat-card { background: white; border: 1px solid var(--paper-line); border-radius: 16px; padding: 16px; }
  .stat-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-soft); margin-bottom: 8px; }
  .stat-value { font-size: 21px; font-weight: 600; }
  .stat-sub { font-size: 12px; margin-top: 4px; }

  .card-title { font-size: 18px; font-weight: 600; margin: 0 0 12px 0; }
  .chart-legend { display: flex; gap: 12px; font-size: 12px; color: var(--ink-soft); align-items: center; }
  .legend-dot { width: 8px; height: 8px; border-radius: 2px; display: inline-block; margin-right: 4px; }

  .chart-scroll { display: flex; align-items: flex-end; gap: 10px; overflow-x: auto; padding-bottom: 4px; }
  .chart-col { display: flex; flex-direction: column; align-items: center; min-width: 58px; flex-shrink: 0; }
  .chart-bars { display: flex; align-items: flex-end; gap: 3px; height: 160px; }
  .chart-bar { width: 15px; border-radius: 3px 3px 0 0; }
  .chart-col-label { font-size: 10px; color: var(--ink-soft); margin-top: 6px; text-align: center; white-space: nowrap; }

  .cat-row { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .cat-row:last-child { margin-bottom: 0; }
  .cat-emoji { flex-shrink: 0; width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 15px; }
  .cat-body { flex: 1; min-width: 0; }
  .cat-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
  .cat-name { font-size: 14px; font-weight: 500; }
  .cat-value { font-size: 14px; }
  .cat-bar-bg { width: 100%; height: 5px; border-radius: 999px; background: var(--paper-line-2); }
  .cat-bar-fill { height: 5px; border-radius: 999px; }

  .tx-row { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--paper-line-2); }
  .tx-row:last-child { border-bottom: none; }
  .tx-icon { flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; }
  .tx-body { flex: 1; min-width: 0; }
  .tx-name { font-size: 14px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tx-note { color: var(--ink-soft); font-weight: 400; }
  .tx-date { font-size: 12px; color: var(--ink-soft); }
  .tx-amount { font-size: 14px; flex-shrink: 0; }
  .del-btn { background: none; border: none; cursor: pointer; color: var(--ink-soft); padding: 4px; opacity: 0; transition: opacity .15s; }
  .tx-row:hover .del-btn { opacity: 1; }

  .empty-note { font-size: 14px; color: var(--ink-soft); }
  .warn-banner { font-size: 14px; margin-bottom: 16px; padding: 10px 14px; border-radius: 8px; background: var(--brick-soft); color: var(--brick); }
</style>
</head>
<body>
<div id="root"></div>

<script type="text/babel">
const { useState, useEffect, useMemo } = React;

const COLORS = {
  ink: "#1F2E27", paper: "#F5F1E6", paperLine: "#DED5B8", paperLine2: "#E9E2CC",
  brass: "#B8923F", sage: "#3F6350", sageSoft: "#DDE6DE",
  brick: "#A85440", brickSoft: "#EEDCD5", inkSoft: "#6B786F",
};

const CATEGORIES = [
  { id: "loan", label: "Empréstimo da casa", emoji: "🏠", color: "#8B5E3C" },
  { id: "house", label: "Despesas da casa", emoji: "🔧", color: "#5F7A56" },
  { id: "fixed", label: "Contas fixas", emoji: "🧾", color: "#4E7396" },
  { id: "market", label: "Supermercado", emoji: "🛒", color: "#A85440" },
  { id: "coffee", label: "Café", emoji: "☕", color: "#8B6A4A" },
  { id: "insurance", label: "Seguro", emoji: "🛡️", color: "#3E7C82" },
  { id: "phone", label: "Telefone", emoji: "📱", color: "#7A5C8B" },
  { id: "car", label: "Carro", emoji: "🚗", color: "#9C7A2E" },
  { id: "other", label: "Outros", emoji: "✳️", color: "#8A8570" },
];

const STORAGE_KEY = "expense-tracker-transactions-local-v1";

const brl = (n) => new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" }).format(Number(n) || 0);

function startOfWeek(d) { const date = new Date(d); const day = date.getDay(); const diff = (day === 0 ? -6 : 1) - day; date.setDate(date.getDate() + diff); date.setHours(0,0,0,0); return date; }
function startOfMonth(d) { const date = new Date(d); date.setHours(0,0,0,0); return new Date(date.getFullYear(), date.getMonth(), 1); }
function addDays(d, n) { const date = new Date(d); date.setDate(date.getDate() + n); return date; }
function addMonths(d, n) { const date = new Date(d); date.setMonth(date.getMonth() + n); return date; }
function addYears(d, n) { const date = new Date(d); date.setFullYear(date.getFullYear() + n); return date; }
function startOfQuinzena(d) { const date = new Date(d); date.setHours(0,0,0,0); return date.getDate() <= 15 ? new Date(date.getFullYear(), date.getMonth(), 1) : new Date(date.getFullYear(), date.getMonth(), 16); }
function nextQuinzenaStart(s) { return s.getDate() === 1 ? new Date(s.getFullYear(), s.getMonth(), 16) : new Date(s.getFullYear(), s.getMonth() + 1, 1); }
function prevQuinzenaStart(s) { return s.getDate() === 16 ? new Date(s.getFullYear(), s.getMonth(), 1) : new Date(s.getFullYear(), s.getMonth() - 1, 16); }
function addQuinzenas(start, n) { let cur = start; if (n < 0) for (let i=0;i<-n;i++) cur = prevQuinzenaStart(cur); else for (let i=0;i<n;i++) cur = nextQuinzenaStart(cur); return cur; }
function startOfQuarter(d) { const date = new Date(d); date.setHours(0,0,0,0); const q = Math.floor(date.getMonth()/3); return new Date(date.getFullYear(), q*3, 1); }
function startOfYear(d) { return new Date(d.getFullYear(), 0, 1); }
function fmtWeekLabel(d) { const end = addDays(d,6); const o = { day:"2-digit", month:"short" }; return `${d.toLocaleDateString("pt-BR",o)}–${end.toLocaleDateString("pt-BR",o)}`; }
function fmtQuinzenaLabel(start) { const end = nextQuinzenaStart(start); const last = addDays(end,-1); const dOpt={day:"2-digit"}; const mOpt={month:"short"}; return `${start.toLocaleDateString("pt-BR",dOpt)}–${last.toLocaleDateString("pt-BR",dOpt)} ${start.toLocaleDateString("pt-BR",mOpt).replace(".","")}`; }
function fmtMonthLabel(d) { return d.toLocaleDateString("pt-BR", { month:"short", year:"2-digit" }).replace(".",""); }
function fmtQuarterLabel(d) { return `T${Math.floor(d.getMonth()/3)+1} ${d.getFullYear()}`; }
function fmtYearLabel(d) { return String(d.getFullYear()); }
function fmtDateShort(iso) { const d = new Date(iso + "T00:00:00"); return d.toLocaleDateString("pt-BR", { day:"2-digit", month:"short" }); }

const PERIOD_CONFIG = {
  week: { start: startOfWeek, step: (d,n) => addDays(d, 7*n), label: fmtWeekLabel, noun: "semana" },
  biweek: { start: startOfQuinzena, step: (d,n) => addQuinzenas(d,n), label: fmtQuinzenaLabel, noun: "quinzena" },
  month: { start: startOfMonth, step: (d,n) => addMonths(d,n), label: fmtMonthLabel, noun: "mês" },
  quarter: { start: startOfQuarter, step: (d,n) => addMonths(d, 3*n), label: fmtQuarterLabel, noun: "trimestre" },
  year: { start: startOfYear, step: (d,n) => addYears(d,n), label: fmtYearLabel, noun: "ano" },
};

function ExpenseTracker() {
  const [transactions, setTransactions] = useState([]);
  const [loaded, setLoaded] = useState(false);
  const [saveError, setSaveError] = useState("");
  const [periodType, setPeriodType] = useState("month");
  const [showForm, setShowForm] = useState(false);

  const [formType, setFormType] = useState("expense");
  const [formCategory, setFormCategory] = useState("market");
  const [formAmount, setFormAmount] = useState("");
  const [formDate, setFormDate] = useState(() => new Date().toISOString().slice(0,10));
  const [formNote, setFormNote] = useState("");

  useEffect(() => {
    try {
      const raw = window.localStorage.getItem(STORAGE_KEY);
      setTransactions(raw ? JSON.parse(raw) : []);
    } catch (e) {
      setTransactions([]);
    } finally {
      setLoaded(true);
    }
  }, []);

  useEffect(() => {
    if (!loaded) return;
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(transactions));
      setSaveError("");
    } catch (e) {
      setSaveError("Não foi possível salvar neste navegador.");
    }
  }, [transactions, loaded]);

  const chartData = useMemo(() => {
    const cfg = PERIOD_CONFIG[periodType];
    const now = new Date();
    const base = cfg.start(now);
    const periods = [];
    for (let i = 5; i >= 0; i--) {
      const start = cfg.step(base, -i);
      const end = cfg.step(start, 1);
      periods.push({ start, end, label: cfg.label(start) });
    }
    return periods.map((p) => {
      let income = 0, expense = 0;
      transactions.forEach((t) => {
        const d = new Date(t.date + "T00:00:00");
        if (d >= p.start && d < p.end) {
          if (t.type === "income") income += Number(t.amount);
          else expense += Number(t.amount);
        }
      });
      return { label: p.label, Receita: income, Despesa: expense, start: p.start, end: p.end };
    });
  }, [transactions, periodType]);

  const current = chartData[chartData.length - 1] || { Receita: 0, Despesa: 0, label: "" };
  const currentSaved = current.Receita - current.Despesa;
  const currentRate = current.Receita > 0 ? (currentSaved / current.Receita) * 100 : 0;

  const categoryBreakdown = useMemo(() => {
    if (!chartData.length) return CATEGORIES.map((c) => ({ ...c, value: 0, pct: 0 }));
    const { start, end } = chartData[chartData.length - 1];
    const sums = {};
    CATEGORIES.forEach((c) => (sums[c.id] = 0));
    transactions.forEach((t) => {
      const d = new Date(t.date + "T00:00:00");
      if (t.type === "expense" && d >= start && d < end) sums[t.categoryId] = (sums[t.categoryId] || 0) + Number(t.amount);
    });
    const max = Math.max(1, ...Object.values(sums));
    return CATEGORIES.map((c) => ({ ...c, value: sums[c.id], pct: (sums[c.id] / max) * 100 }));
  }, [transactions, chartData]);

  const allTime = useMemo(() => {
    let income = 0, expense = 0;
    transactions.forEach((t) => (t.type === "income" ? (income += Number(t.amount)) : (expense += Number(t.amount))));
    const saved = income - expense;
    const rate = income > 0 ? (saved / income) * 100 : 0;
    return { income, expense, saved, rate };
  }, [transactions]);

  const recent = useMemo(() => [...transactions].sort((a,b) => (a.date < b.date ? 1 : -1)).slice(0, 8), [transactions]);
  const maxChart = Math.max(1, ...chartData.map(d => Math.max(d.Receita, d.Despesa)));

  function resetForm() { setFormType("expense"); setFormCategory("market"); setFormAmount(""); setFormDate(new Date().toISOString().slice(0,10)); setFormNote(""); }

  function handleAdd() {
    const amt = parseFloat(String(formAmount).replace(",", "."));
    if (!amt || amt <= 0) return;
    const t = { id: Date.now().toString(36) + Math.random().toString(36).slice(2), type: formType, categoryId: formType === "expense" ? formCategory : null, amount: amt, date: formDate, note: formNote.trim() };
    setTransactions((prev) => [...prev, t]);
    resetForm();
    setShowForm(false);
  }

  function handleDelete(id) { setTransactions((prev) => prev.filter((t) => t.id !== id)); }

  const periodNoun = PERIOD_CONFIG[periodType].noun;

  return (
    <div className="wrap">
      <div className="header">
        <div>
          <div className="eyebrow">Livro de contas</div>
          <h1 className="ledger-font">Controle de Gastos</h1>
          <p className="subtitle">Casa, mercado, café e o resto da vida — tudo lançado num só lugar.</p>
        </div>
        <div className="stamp mono-font">
          <div className="stamp-value">{allTime.income > 0 ? `${allTime.rate.toFixed(0)}%` : "—"}</div>
          <div className="stamp-label">poupado<br />no total</div>
        </div>
      </div>

      {saveError && <div className="warn-banner">{saveError}</div>}

      <div className="toolbar">
        <div className="toggle">
          {[{id:"week",label:"Semanal"},{id:"biweek",label:"Quinzenal"},{id:"month",label:"Mensal"},{id:"quarter",label:"Trimestral"},{id:"year",label:"Anual"}].map((opt) => (
            <button key={opt.id} className={"toggle-btn" + (periodType === opt.id ? " active" : "")} onClick={() => setPeriodType(opt.id)}>{opt.label}</button>
          ))}
        </div>
        <button className="btn btn-primary" onClick={() => setShowForm((s) => !s)}>{showForm ? "✕ Fechar" : "+ Lançar"}</button>
      </div>

      {showForm && (
        <div className="panel">
          <div className="type-toggle">
            <button className={"type-btn" + (formType === "expense" ? " active-expense" : "")} onClick={() => setFormType("expense")}>Despesa</button>
            <button className={"type-btn" + (formType === "income" ? " active-income" : "")} onClick={() => setFormType("income")}>Receita</button>
          </div>
          <div className="form-grid">
            {formType === "expense" && (
              <div className="field-full">
                <label className="field-label">Categoria</label>
                <select value={formCategory} onChange={(e) => setFormCategory(e.target.value)}>
                  {CATEGORIES.map((c) => <option key={c.id} value={c.id}>{c.label}</option>)}
                </select>
              </div>
            )}
            <div>
              <label className="field-label">Valor (R$)</label>
              <input type="text" inputMode="decimal" placeholder="0,00" value={formAmount} onChange={(e) => setFormAmount(e.target.value)} className="mono-font" />
            </div>
            <div>
              <label className="field-label">Data</label>
              <input type="date" value={formDate} onChange={(e) => setFormDate(e.target.value)} />
            </div>
            <div className="field-full">
              <label className="field-label">Observação (opcional)</label>
              <input type="text" placeholder="ex.: café com a Ju no sábado" value={formNote} onChange={(e) => setFormNote(e.target.value)} />
            </div>
          </div>
          <button className="btn btn-save" onClick={handleAdd}>Salvar lançamento</button>
        </div>
      )}

      <div className="stat-grid">
        <div className="stat-card">
          <div className="stat-label">Receita da {periodNoun}</div>
          <div className="stat-value mono-font">{brl(current.Receita)}</div>
        </div>
        <div className="stat-card">
          <div className="stat-label">Despesa da {periodNoun}</div>
          <div className="stat-value mono-font">{brl(current.Despesa)}</div>
        </div>
        <div className="stat-card">
          <div className="stat-label">Saldo da {periodNoun}</div>
          <div className="stat-value mono-font">{brl(currentSaved)}</div>
          {current.Receita > 0 && <div className="stat-sub" style={{color: currentSaved >= 0 ? COLORS.sage : COLORS.brick}}>{currentRate.toFixed(0)}% guardado</div>}
        </div>
      </div>

      <div className="card">
        <div style={{display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:12}}>
          <h2 className="card-title ledger-font">Receita x Despesa</h2>
          <div className="chart-legend">
            <span><span className="legend-dot" style={{background: COLORS.sage}}></span>Receita</span>
            <span><span className="legend-dot" style={{background: COLORS.brick}}></span>Despesa</span>
          </div>
        </div>
        <div className="chart-scroll">
          {chartData.map((d, i) => (
            <div className="chart-col" key={i}>
              <div className="chart-bars">
                <div className="chart-bar" title={`Receita: ${brl(d.Receita)}`} style={{height: Math.max(2, (d.Receita/maxChart)*160), background: COLORS.sage}}></div>
                <div className="chart-bar" title={`Despesa: ${brl(d.Despesa)}`} style={{height: Math.max(2, (d.Despesa/maxChart)*160), background: COLORS.brick}}></div>
              </div>
              <div className="chart-col-label">{d.label}</div>
            </div>
          ))}
        </div>
      </div>

      <div className="card">
        <h2 className="card-title ledger-font">Por categoria — {current.label || `${periodNoun} atual`}</h2>
        {categoryBreakdown.every((c) => c.value === 0) ? (
          <p className="empty-note">Nenhuma despesa lançada neste período ainda.</p>
        ) : (
          categoryBreakdown.map((c) => (
            <div className="cat-row" key={c.id}>
              <div className="cat-emoji" style={{background: c.color + "20"}}>{c.emoji}</div>
              <div className="cat-body">
                <div className="cat-top">
                  <span className="cat-name">{c.label}</span>
                  <span className="cat-value mono-font">{brl(c.value)}</span>
                </div>
                <div className="cat-bar-bg"><div className="cat-bar-fill" style={{width: c.pct + "%", background: c.color}}></div></div>
              </div>
            </div>
          ))
        )}
      </div>

      <div className="card" style={{marginBottom: 0}}>
        <h2 className="card-title ledger-font">Últimos lançamentos</h2>
        {recent.length === 0 ? (
          <p className="empty-note">Ainda não há lançamentos. Toque em "+ Lançar" para começar o seu livro de contas.</p>
        ) : (
          recent.map((t) => {
            const cat = t.type === "expense" ? CATEGORIES.find((c) => c.id === t.categoryId) : null;
            const emoji = cat ? cat.emoji : "💰";
            const color = cat ? cat.color : COLORS.sage;
            return (
              <div className="tx-row" key={t.id}>
                <div className="tx-icon" style={{background: color + "20"}}>{emoji}</div>
                <div className="tx-body">
                  <div className="tx-name">{cat ? cat.label : "Receita"}{t.note ? <span className="tx-note"> · {t.note}</span> : null}</div>
                  <div className="tx-date">{fmtDateShort(t.date)}</div>
                </div>
                <div className="tx-amount mono-font" style={{color: t.type === "income" ? COLORS.sage : COLORS.brick}}>{t.type === "income" ? "+" : "−"}{brl(t.amount)}</div>
                <button className="del-btn" onClick={() => handleDelete(t.id)} aria-label="Excluir lançamento">✕</button>
              </div>
            );
          })
        )}
      </div>
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<ExpenseTracker />);
</script>
</body>
</html>
